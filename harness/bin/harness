#!/usr/bin/env python3
"""
harness — control plane for the Claude Code secure-SDLC harness.

The orchestrator session (Fable) runs in the user's Ghostty tab and calls this
CLI to create runs, define work packages, spawn Sonnet worker sessions into new
terminal tabs, wait for their evidence, and evaluate the deterministic policy
gate. Worker sessions call it to get their run envelope, applicable practice
packs, the current revision id, and to validate their result contract.

Nothing here calls a model. Every decision the gate makes is computed from
structured evidence files under <project>/.harness/runs/<run-id>/.
"""
import argparse
import datetime as _dt
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import uuid

HARNESS_HOME = os.path.expanduser(os.path.expandvars(os.environ.get("HARNESS_HOME", "~/.claude/harness")))
CONFIG_PATH = os.path.join(HARNESS_HOME, "config.json")
POLICY_PATH = os.path.join(HARNESS_HOME, "policy", "gate-policy.json")
SCHEMA_PATH = os.path.join(HARNESS_HOME, "schemas", "result.schema.json")
PACKS_DIR = os.path.join(HARNESS_HOME, "packs")
LAUNCH_DIR = os.path.join(HARNESS_HOME, "launch")
PREAMBLE_PATH = os.path.join(HARNESS_HOME, "templates", "worker-preamble.md")

GATE_EXIT = {"PASS": 0, "FAIL": 1, "NEEDS_HUMAN": 2, "NOT_APPLICABLE": 3}


# ----------------------------------------------------------------------------
# small utilities
# ----------------------------------------------------------------------------

def now_iso():
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        if default is not None:
            return default
        raise


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=False)
        f.write("\n")
    os.replace(tmp, path)


def sha256_text(text):
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def config():
    return load_json(CONFIG_PATH, default={})


def die(msg, code=1):
    print(f"harness: {msg}", file=sys.stderr)
    sys.exit(code)


def project_root(start=None):
    """Project root = nearest ancestor containing .harness, else git toplevel, else cwd."""
    start = os.path.abspath(start or os.getcwd())
    cur = start
    while True:
        if os.path.isdir(os.path.join(cur, ".harness")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=start,
                             capture_output=True, text=True, check=True).stdout.strip()
        if out:
            return out
    except Exception:
        pass
    return start


def runs_dir(root):
    return os.path.join(root, ".harness", "runs")


def run_dir(root, run_id):
    d = os.path.join(runs_dir(root), run_id)
    if not os.path.isdir(d):
        die(f"run '{run_id}' not found under {runs_dir(root)}")
    return d


def latest_run_id(root):
    d = runs_dir(root)
    if not os.path.isdir(d):
        return None
    ids = sorted(x for x in os.listdir(d) if os.path.isdir(os.path.join(d, x)))
    return ids[-1] if ids else None


def resolve_run(root, run_id):
    if run_id in (None, "", "latest"):
        rid = os.environ.get("HARNESS_RUN") or latest_run_id(root)
        if not rid:
            die("no run id given and no runs exist; create one with: harness run new --request '...'")
        return rid
    return run_id


def audit(root, run_id, event_type, data, actor=None):
    """Append-only, hash-chained audit trail per run."""
    rd = os.path.join(runs_dir(root), run_id)
    path = os.path.join(rd, "audit.jsonl")
    prev = "sha256:genesis"
    seq = 0
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    seq += 1
                    prev = json.loads(line).get("event_digest", prev)
    ev = {
        "event_id": "evt-" + uuid.uuid4().hex[:12],
        "sequence": seq + 1,
        "timestamp": now_iso(),
        "event_type": event_type,
        "actor": actor or os.environ.get("HARNESS_PRINCIPAL") or config().get("orchestrator_principal", "orchestrator"),
        "data": data,
        "previous_event_digest": prev,
    }
    ev["event_digest"] = sha256_text(json.dumps(ev, sort_keys=True))
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(ev) + "\n")


# ----------------------------------------------------------------------------
# revision identity
# ----------------------------------------------------------------------------

def git(root, *args):
    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)


def is_git(root):
    r = git(root, "rev-parse", "--is-inside-work-tree")
    return r.returncode == 0 and r.stdout.strip() == "true"


def revision_id(root):
    """Stable identifier of the exact working-tree content being gated.

    git repos: git:<HEAD>+wt:<digest of tracked diff + untracked file contents>
    non-git:  tree:<digest of relative path, size, mtime for every file>
    """
    if is_git(root):
        head = git(root, "rev-parse", "HEAD").stdout.strip() or "unborn"
        diff = git(root, "diff", "HEAD", "--", ".", ":(exclude).harness").stdout
        h = hashlib.sha256(diff.encode("utf-8", "replace"))
        untracked = git(root, "ls-files", "--others", "--exclude-standard").stdout.split("\n")
        for rel in sorted(u for u in untracked if u and not u.startswith(".harness")):
            p = os.path.join(root, rel)
            if os.path.isfile(p):
                h.update(rel.encode())
                with open(p, "rb") as f:
                    h.update(hashlib.sha256(f.read()).digest())
        return f"git:{head[:12]}+wt:{h.hexdigest()[:16]}"
    h = hashlib.sha256()
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in (".harness", ".git", "node_modules", ".venv", "__pycache__"))
        for fn in sorted(filenames):
            p = os.path.join(dirpath, fn)
            try:
                st = os.stat(p)
            except OSError:
                continue
            h.update(f"{os.path.relpath(p, root)}|{st.st_size}|{int(st.st_mtime)}\n".encode())
    return f"tree:{h.hexdigest()[:16]}"


def changed_files(root, since_rev_note=None):
    """Files changed in the working tree relative to HEAD (git only)."""
    if not is_git(root):
        return []
    out = git(root, "status", "--porcelain", "--", ".", ":(exclude).harness").stdout
    files = []
    for line in out.splitlines():
        if len(line) > 3:
            path = line[3:].strip()
            if " -> " in path:
                path = path.split(" -> ", 1)[1]
            files.append(path)
    return files


# ----------------------------------------------------------------------------
# risk classification helper (hints only; the orchestrator decides)
# ----------------------------------------------------------------------------

RISK_PATTERNS = [
    # (regex, change_type, minimum_risk, reason)
    (r"(^|/)(auth|authn|authz|login|session|oauth|sso|jwt|passport|permission|rbac|acl)[^/]*", "authentication", "R3", "authentication/authorization surface"),
    (r"(^|/)(crypto|cipher|kms|hsm|signing|signature|tls|ssl)[^/]*", "cryptography", "R3", "cryptography"),
    (r"(^|/)(secret|credential|vault|\.env|keychain)[^/]*", "secrets", "R3", "secret handling"),
    (r"(^|/)\.github/workflows/|(^|/)\.gitlab-ci|(^|/)Jenkinsfile|(^|/)\.circleci/|(^|/)azure-pipelines|(^|/)bitbucket-pipelines", "ci_cd", "R3", "CI/CD trust path"),
    (r"(^|/)(Dockerfile|docker-compose[^/]*|k8s/|kubernetes/|helm/|terraform/|\.tf$|pulumi|ansible/|cloudformation)", "infrastructure", "R3", "deployment infrastructure"),
    (r"(^|/)(agent|agents|tools?|mcp|prompt|prompts|llm|openai|anthropic|langchain|retriev|rag)[^/]*", "ai_agent", "R3", "AI/agent/tool-calling surface"),
    (r"(^|/)(sandbox|exec|eval|subprocess|shell|spawn)[^/]*", "tool_execution", "R3", "code execution path"),
    (r"(^|/)(migrations?|schema|alembic|prisma/|flyway|liquibase)[^/]*", "database_schema", "R2", "schema/migration"),
    (r"(^|/)(package\.json|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|requirements[^/]*\.txt|pyproject\.toml|poetry\.lock|Pipfile[^/]*|go\.mod|go\.sum|Cargo\.toml|Cargo\.lock|Gemfile[^/]*|pom\.xml|build\.gradle[^/]*|composer\.(json|lock))$", "dependency", "R2", "dependency manifest/lock"),
    (r"(^|/)(api|routes?|controllers?|handlers?|endpoints?|graphql|grpc|webhooks?|callbacks?)[^/]*", "public_api", "R2", "externally reachable interface"),
    (r"(^|/)(upload|parser|parse|deserializ|unmarshal|multipart)[^/]*", "input_processing", "R2", "untrusted input parsing"),
    (r"(^|/)(logging|logger|audit)[^/]*", "logging_observability", "R2", "security-relevant logging"),
    (r"(^|/)(setup\.py|setup\.cfg|Makefile|CMakeLists\.txt|webpack|vite\.config|tsconfig|babel\.config|rollup)[^/]*", "build_configuration", "R2", "build configuration"),
    (r"\.(md|mdx|rst|txt|adoc)$|(^|/)docs?/|(^|/)LICENSE|(^|/)CHANGELOG", "documentation", "R0", "documentation"),
    (r"(^|/)(tests?|__tests__|spec|specs)/|[._-](test|spec)\.[a-z]+$|^test_", "test_only", "R1", "tests"),
]
RISK_ORDER = {"R0": 0, "R1": 1, "R2": 2, "R3": 3}


def classify_paths(paths):
    hints = []
    max_risk = "R1" if paths else "R0"
    doc_only = True
    for p in paths:
        matched = False
        for rx, ctype, risk, reason in RISK_PATTERNS:
            if re.search(rx, p, re.IGNORECASE):
                hints.append({"path": p, "change_type": ctype, "min_risk": risk, "reason": reason})
                if RISK_ORDER[risk] > RISK_ORDER[max_risk]:
                    max_risk = risk
                if ctype != "documentation":
                    doc_only = False
                matched = True
                break
        if not matched:
            doc_only = False
            hints.append({"path": p, "change_type": "business_logic", "min_risk": "R1", "reason": "executable file (default)"})
    if paths and doc_only:
        max_risk = "R0"
    return {"suggested_min_risk": max_risk, "doc_only": doc_only, "hints": hints,
            "note": "Hints only. The orchestrator MUST classify using the highest-risk applicable characteristic and MAY raise, never lower below these hints without recorded evidence."}


# ----------------------------------------------------------------------------
# runs
# ----------------------------------------------------------------------------

def cmd_run_new(args):
    root = project_root()
    rid = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:4]
    rd = os.path.join(runs_dir(root), rid)
    os.makedirs(os.path.join(rd, "tasks"), exist_ok=True)
    os.makedirs(os.path.join(rd, "waivers"), exist_ok=True)
    os.makedirs(os.path.join(rd, "approvals"), exist_ok=True)
    # keep evidence out of version control without touching tracked files
    if is_git(root):
        excl = os.path.join(root, ".git", "info", "exclude")
        try:
            os.makedirs(os.path.dirname(excl), exist_ok=True)
            existing = open(excl).read() if os.path.exists(excl) else ""
            if ".harness/" not in existing:
                with open(excl, "a") as f:
                    f.write("\n# claude harness evidence (local)\n.harness/\n")
        except OSError:
            pass
    base_rev = revision_id(root)
    run = {
        "schema_version": "engineering-orchestrator/v1",
        "run_id": rid,
        "created_at": now_iso(),
        "project_root": root,
        "request": {"summary": args.request or "", "mode": args.mode or "CHANGE", "acceptance_criteria": []},
        "repository": {"baseline_revision": base_rev, "preexisting_changes": changed_files(root), "is_git": is_git(root)},
        "classification": {
            "primary_change_type": None, "secondary_change_types": [],
            "externally_exposed": None, "security_boundary_affected": None, "privilege_boundary_affected": None,
            "persistent_data_affected": None, "third_party_code_added": None, "build_or_release_path_affected": None,
            "untrusted_input_affected": None, "irreversible_effect_possible": None,
        },
        "risk": {"level": None, "triggers": [], "downgrade_allowed": False, "history": []},
        "workflow": {"model": None, "source": None, "stages": []},
        "ai_scope": "none",
        "languages": [],
        "scope": {"allowed_paths": [], "forbidden_paths": []},
        "not_applicable": {},
        "remediation_cycles": 0,
        "status": {"state": "PENDING", "blockers": [], "uncertainties": []},
    }
    save_json(os.path.join(rd, "run.json"), run)
    audit(root, rid, "RUN_CREATED", {"request": run["request"], "baseline_revision": base_rev})
    print(json.dumps({"run_id": rid, "run_dir": rd, "baseline_revision": base_rev,
                      "preexisting_changes": run["repository"]["preexisting_changes"],
                      "next": "classify, then: harness run set <run> risk=R? mode=CHANGE change_types=a,b flags.externally_exposed=true ..."}, indent=2))


def _set_path(obj, dotted, value):
    parts = dotted.split(".")
    cur = obj
    for p in parts[:-1]:
        cur = cur.setdefault(p, {})
    cur[parts[-1]] = value


def _coerce(v):
    if v.lower() in ("true", "false"):
        return v.lower() == "true"
    if v.lower() in ("null", "none"):
        return None
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    if "," in v:
        return [x.strip() for x in v.split(",") if x.strip()]
    return v


def cmd_run_set(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    run = load_json(os.path.join(rd, "run.json"))
    changes = {}
    for kv in args.assignments:
        if "=" not in kv:
            die(f"bad assignment '{kv}', expected key=value")
        k, v = kv.split("=", 1)
        val = _coerce(v)
        alias = {
            "risk": "risk.level", "mode": "request.mode", "request": "request.summary",
            "workflow": "workflow.model", "workflow_source": "workflow.source", "stages": "workflow.stages",
            "change_types": "classification.secondary_change_types", "primary": "classification.primary_change_type",
            "acceptance": "request.acceptance_criteria", "triggers": "risk.triggers",
            "allowed_paths": "scope.allowed_paths", "forbidden_paths": "scope.forbidden_paths",
            "state": "status.state",
        }
        k = alias.get(k, k)
        if k.startswith("flags."):
            k = "classification." + k[len("flags."):]
        if k.startswith("na."):
            k = "not_applicable." + k[len("na."):]
        if k in ("request.acceptance_criteria", "risk.triggers", "workflow.stages", "classification.secondary_change_types",
                 "scope.allowed_paths", "scope.forbidden_paths", "languages") and isinstance(val, str):
            val = [val]
        if k == "risk.level":
            if val not in RISK_ORDER:
                die("risk must be one of R0 R1 R2 R3")
            prev = run["risk"].get("level")
            if prev and RISK_ORDER[val] < RISK_ORDER[prev] and not args.justify:
                die(f"risk downgrade {prev} -> {val} requires --justify '<evidence>'")
            run["risk"]["history"].append({"at": now_iso(), "from": prev, "to": val, "justification": args.justify})
        _set_path(run, k, val)
        changes[k] = val
    save_json(os.path.join(rd, "run.json"), run)
    audit(root, rid, "RUN_UPDATED", changes)
    print(json.dumps({"run_id": rid, "updated": changes}, indent=2))


def cmd_run_show(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    print(json.dumps(load_json(os.path.join(run_dir(root, rid), "run.json")), indent=2))


def cmd_runs(args):
    root = project_root()
    d = runs_dir(root)
    if not os.path.isdir(d):
        print("no runs")
        return
    for rid in sorted(os.listdir(d)):
        p = os.path.join(d, rid, "run.json")
        if os.path.exists(p):
            r = load_json(p)
            print(f"{rid}  risk={r['risk'].get('level')}  state={r['status'].get('state')}  {r['request'].get('summary','')[:70]}")


def cmd_classify(args):
    paths = list(args.paths or [])
    if args.git:
        root = project_root()
        paths += changed_files(root)
    print(json.dumps(classify_paths(paths), indent=2))


# ----------------------------------------------------------------------------
# tasks (work packages)
# ----------------------------------------------------------------------------

ROLES = ["context", "requirements", "governance", "threat-model", "architecture-review", "dependency-review",
         "domain-specialist", "implementer", "test-verification", "code-review", "security-review",
         "security-testing", "ai-adversarial-testing", "build-security", "secure-defaults", "release-integrity",
         "vulnerability-discovery", "triage", "remediation", "root-cause", "regression-prevention", "other"]

WRITE_ROLES = {"implementer", "remediation", "regression-prevention", "domain-specialist"}


def task_dir(rd, task_id):
    return os.path.join(rd, "tasks", task_id)


def cmd_task_new(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    run = load_json(os.path.join(rd, "run.json"))
    if args.role not in ROLES:
        die(f"role must be one of: {', '.join(ROLES)}")
    agent_path = os.path.expanduser(f"~/.claude/agents/{args.agent}.md")
    if not os.path.exists(agent_path):
        die(f"agent definition not found: {agent_path}")
    td = task_dir(rd, args.id)
    if os.path.exists(td):
        die(f"task '{args.id}' already exists")
    os.makedirs(td)
    if args.package_file:
        pkg = open(args.package_file, encoding="utf-8").read()
    elif not sys.stdin.isatty():
        pkg = sys.stdin.read()
    else:
        die("provide --package-file or pipe the work package on stdin")
    write = bool(args.write) or (args.role in WRITE_ROLES and args.write is None)
    if args.role in ("code-review", "security-review", "security-testing", "ai-adversarial-testing", "test-verification",
                     "threat-model", "architecture-review", "requirements", "context", "dependency-review", "release-integrity",
                     "triage", "root-cause", "vulnerability-discovery", "governance", "secure-defaults", "build-security") and write:
        die(f"role '{args.role}' is read-only with respect to product code; drop --write")
    task = {
        "task_id": args.id, "run_id": rid, "agent": args.agent, "role": args.role,
        "principal_id": f"agent:{args.agent}", "write": write,
        "depends_on": [x for x in (args.depends or "").split(",") if x],
        "retry_of": args.retry_of, "title": args.title or f"{args.role} ({args.agent})",
        "created_at": now_iso(), "spawned_at": None, "spawn_backend": None, "revision_at_spawn": None,
        "expected_revision": args.revision,
    }
    save_json(os.path.join(td, "task.json"), task)
    with open(os.path.join(td, "package.md"), "w", encoding="utf-8") as f:
        f.write(pkg)
    audit(root, rid, "TASK_CREATED", {"task": task})
    print(json.dumps({"run_id": rid, "task_id": args.id, "task_dir": td, "write": write,
                      "next": f"harness spawn --run {rid} --task {args.id}"}, indent=2))


def cmd_task_list(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    for t in _tasks(rd):
        res = t.get("result") or {}
        print(f"{t['task_id']:<18} {t['role']:<22} {t['agent']:<24} write={str(t['write']):<5} "
              f"spawned={'yes' if t.get('spawned_at') else 'no ':<3} result={res.get('status') or '-'}")


def _tasks(rd):
    out = []
    tdir = os.path.join(rd, "tasks")
    if not os.path.isdir(tdir):
        return out
    for tid in sorted(os.listdir(tdir)):
        tp = os.path.join(tdir, tid, "task.json")
        if not os.path.exists(tp):
            continue
        t = load_json(tp)
        rp = os.path.join(tdir, tid, "result.json")
        t["result"] = load_json(rp) if os.path.exists(rp) else None
        t["result_path"] = rp
        out.append(t)
    return out


# ----------------------------------------------------------------------------
# spawning worker sessions into terminal tabs
# ----------------------------------------------------------------------------

def detect_terminal(cfg):
    forced = os.environ.get("HARNESS_TERMINAL") or cfg.get("terminal", "auto")
    if forced and forced != "auto":
        return forced
    if os.environ.get("CMUX_WORKSPACE_ID") or os.environ.get("CMUX_SURFACE_ID"):
        return "cmux"
    if shutil.which("cmux") and cmux_socket_path():
        return "cmux"
    tp = os.environ.get("TERM_PROGRAM", "")
    if tp == "ghostty":
        return "ghostty"
    if tp == "iTerm.app":
        return "iterm"
    if tp == "Apple_Terminal":
        return "terminal"
    if os.environ.get("TMUX"):
        return "tmux"
    if os.path.isdir("/Applications/Ghostty.app") or os.path.isdir(os.path.expanduser("~/Applications/Ghostty.app")):
        return "ghostty"
    if sys.platform == "darwin":
        return "terminal"
    return "bg"


def osascript(script):
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "osascript failed")
    return r.stdout.strip()


def _keys_clause(keys):
    """AppleScript for a shortcut. Prefer key codes (reliable with modifiers): t=17, [=33, ]=30."""
    mods = ", ".join(keys.get("modifiers", []))
    if "key_code" in keys:
        return f'key code {int(keys["key_code"])} using {{{mods}}}' if mods else f'key code {int(keys["key_code"])}'
    return f'keystroke "{keys["key"]}" using {{{mods}}}' if mods else f'keystroke "{keys["key"]}"'


def cmux_socket_path():
    """Return the cmux socket path if one exists (release builds use ~/.local/state/cmux/cmux.sock; older docs say /tmp/cmux.sock)."""
    for cand in (os.environ.get("CMUX_SOCKET_PATH"), os.path.expanduser("~/.local/state/cmux/cmux.sock"), "/tmp/cmux.sock"):
        if cand and os.path.exists(cand):
            return cand
    return None


def cmux_bin():
    return shutil.which("cmux") or "/Applications/cmux.app/Contents/Resources/bin/cmux"


def cmux_run(args, timeout=20):
    env = dict(os.environ)
    env["CMUX_QUIET"] = "1"  # suppress alias-rename notices so stdout stays parseable
    return subprocess.run([cmux_bin(), *args], capture_output=True, text=True, timeout=timeout, env=env)


def cmux_notify(title, body, workspace=None):
    """Best-effort sidebar notification in cmux (no-op if cmux is not around)."""
    try:
        args = ["notify", "--title", title[:80], "--body", body[:400]]
        if workspace:
            args += ["--workspace", workspace]
        cmux_run(args, timeout=5)
    except Exception:
        pass


def open_tab(backend, command, title, cfg, cwd=None):
    """Run `command` (a short shell line) in a new tab/workspace of the user's terminal. Returns backend used (or info)."""
    if backend == "cmux":
        args = ["new-workspace", "--name", title, "--command", command,
                "--focus", "true" if cfg.get("cmux_focus_new_workspace", False) else "false"]
        if cwd:
            args += ["--cwd", cwd]
        r = cmux_run(args)
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip() or "cmux new-workspace failed")
        ws = None
        m = re.search(r"(workspace:\d+|[0-9a-fA-F-]{36})", r.stdout)
        if m:
            ws = m.group(1)
            try:
                cmux_run(["set-status", "harness", title, "--icon", "sparkle", "--color", "#5b8def", "--workspace", ws], timeout=5)
            except Exception:
                pass
        return {"backend": "cmux", "workspace": ws, "raw": r.stdout.strip()}
    if backend == "ghostty":
        settle = float(cfg.get("ghostty_tab_settle_seconds", 0.8))
        script = f'''
tell application "Ghostty" to activate
delay 0.3
tell application "System Events"
    {_keys_clause(cfg.get("ghostty_new_tab_keys", {"key": "t", "modifiers": ["command down"]}))}
    delay {settle}
    keystroke "{command}"
    key code 36
end tell
'''
        osascript(script)
        if cfg.get("return_to_main_tab", True):
            time.sleep(0.4)
            osascript('tell application "System Events" to ' + _keys_clause(
                cfg.get("ghostty_prev_tab_keys", {"key": "[", "modifiers": ["command down", "shift down"]})))
        return "ghostty"
    if backend == "iterm":
        osascript(f'''
tell application "iTerm"
    tell current window
        create tab with default profile
        tell current session to write text "{command}"
    end tell
end tell''')
        return "iterm"
    if backend == "terminal":
        osascript(f'tell application "Terminal" to do script "{command}"')
        return "terminal"
    if backend == "tmux":
        subprocess.run(["tmux", "new-window", "-d", "-n", title[:20], command], check=True)
        return "tmux"
    if backend == "bg":
        return "bg"
    die(f"unknown terminal backend '{backend}'")


def cmd_spawn(args):
    cfg = config()
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    run = load_json(os.path.join(rd, "run.json"))
    td = task_dir(rd, args.task)
    if not os.path.isdir(td):
        die(f"task '{args.task}' not found")
    task = load_json(os.path.join(td, "task.json"))
    if task.get("spawned_at") and not args.force:
        die(f"task '{args.task}' was already spawned at {task['spawned_at']} (use --force to respawn)")
    # dependency check: all depends_on must have PASS/NOT_APPLICABLE results
    for dep in task.get("depends_on", []):
        rp = os.path.join(rd, "tasks", dep, "result.json")
        if not os.path.exists(rp):
            die(f"dependency '{dep}' has no result yet; spawn order violates required serialization")
        st = load_json(rp).get("status")
        if st not in ("PASS", "NOT_APPLICABLE") and not args.force:
            die(f"dependency '{dep}' finished with status {st}; resolve it before spawning '{args.task}'")
    rev = revision_id(root)
    task["revision_at_spawn"] = rev
    if not task.get("write"):
        task["expected_revision"] = task.get("expected_revision") or rev

    model = args.model or cfg.get("worker_model", "sonnet")
    effort = args.effort or cfg.get("worker_effort", "high")
    perm = args.permission_mode or cfg.get("worker_permission_mode", "acceptEdits")
    name = f"{task['task_id']} {task['agent']}"
    result_path = os.path.join(td, "result.json")
    env = {
        "HARNESS_HOME": HARNESS_HOME,
        "HARNESS_RUN": rid,
        "HARNESS_TASK": task["task_id"],
        "HARNESS_ROLE": task["role"],
        "HARNESS_AGENT": task["agent"],
        "HARNESS_PRINCIPAL": task["principal_id"],
        "HARNESS_WRITE": "1" if task.get("write") else "0",
        "HARNESS_RESULT": result_path,
        "HARNESS_TASK_DIR": td,
        "HARNESS_PROJECT": root,
        "HARNESS_RISK": run["risk"].get("level") or "unclassified",
        "HARNESS_REVISION_AT_SPAWN": rev,
    }
    preamble = open(PREAMBLE_PATH, encoding="utf-8").read() if os.path.exists(PREAMBLE_PATH) else ""
    envelope = {
        "run_id": rid, "task_id": task["task_id"], "agent": task["agent"], "role": task["role"],
        "principal_id": task["principal_id"], "write_allowed": bool(task.get("write")),
        "risk_level": run["risk"].get("level"), "ai_scope": run.get("ai_scope"), "mode": run["request"].get("mode"),
        "request_summary": run["request"].get("summary"), "acceptance_criteria": run["request"].get("acceptance_criteria"),
        "classification": run.get("classification"), "scope": run.get("scope"), "languages": run.get("languages"),
        "revision_at_spawn": rev, "result_path": result_path, "task_dir": td, "project_root": root,
        "upstream_results": [os.path.join(rd, "tasks", d, "result.json") for d in task.get("depends_on", [])],
    }
    save_json(os.path.join(td, "envelope.json"), envelope)
    system_append = preamble.replace("{{ENVELOPE}}", json.dumps(envelope, indent=2))
    with open(os.path.join(td, "system-append.md"), "w", encoding="utf-8") as f:
        f.write(system_append)

    exports = "\n".join(f"export {k}={shlex.quote(v)}" for k, v in env.items())
    claude_bin = shutil.which("claude") or os.path.expanduser("~/.local/bin/claude")
    perm_flag = f"--permission-mode {shlex.quote(perm)}"
    if perm == "bypassPermissions":
        perm_flag = "--dangerously-skip-permissions"
    launch = f"""#!/usr/bin/env bash
# generated by harness spawn — worker session for {task['task_id']} ({task['agent']})
set -u
cd {shlex.quote(root)}
{exports}
export PATH="{os.path.join(HARNESS_HOME, 'bin')}:$HOME/.local/bin:$PATH"
printf '\\033]0;%s\\007' {shlex.quote(name)}
echo "harness worker: run={rid} task={task['task_id']} agent={task['agent']} role={task['role']} write={env['HARNESS_WRITE']}"
echo "result contract: {result_path}"
exec {shlex.quote(claude_bin)} --model {shlex.quote(model)} --effort {shlex.quote(effort)} \\
  --agent {shlex.quote(task['agent'])} --name {shlex.quote(name)} {perm_flag} \\
  --append-system-prompt "$(cat {shlex.quote(os.path.join(td, 'system-append.md'))})" \\
  {'' if not args.headless else '-p --output-format text '}"$(cat {shlex.quote(os.path.join(td, 'package.md'))})"
"""
    os.makedirs(LAUNCH_DIR, exist_ok=True)
    launch_path = os.path.join(LAUNCH_DIR, f"{rid}-{task['task_id']}.sh")
    with open(launch_path, "w", encoding="utf-8") as f:
        f.write(launch)
    os.chmod(launch_path, 0o755)
    shutil.copy(launch_path, os.path.join(td, "launch.sh"))

    backend = args.terminal or detect_terminal(cfg)
    if args.headless:
        backend = "bg"
    command = f"bash {launch_path}"
    if args.dry_run:
        print(json.dumps({"dry_run": True, "backend": backend, "command": command, "launch_script": launch_path,
                          "model": model, "effort": effort, "permission_mode": perm}, indent=2))
        return
    try:
        used = open_tab(backend, command, name, cfg, cwd=root)
    except Exception as e:
        if backend == "cmux":
            die(f"cmux could not open a workspace ({e}). Is cmux running and is this session inside cmux? "
                f"Fallback: harness spawn --terminal bg  (or --terminal ghostty/iterm/terminal)")
        raise
    ws_ref = None
    if isinstance(used, dict):
        ws_ref = used.get("workspace")
        used = used["backend"]
    if used == "bg":
        log = os.path.join(td, "worker.log")
        with open(log, "ab") as lf:
            subprocess.Popen(["bash", launch_path], stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             cwd=root, start_new_session=True)
    task["spawned_at"] = now_iso()
    task["spawn_backend"] = used
    task["cmux_workspace"] = ws_ref
    task["model"] = model
    task["effort"] = effort
    save_json(os.path.join(td, "task.json"), task)
    audit(root, rid, "TASK_SPAWNED", {"task_id": task["task_id"], "agent": task["agent"], "role": task["role"],
                                      "backend": used, "model": model, "effort": effort, "revision": rev})
    print(json.dumps({"spawned": task["task_id"], "agent": task["agent"], "backend": used, "cmux_workspace": ws_ref, "model": model,
                      "effort": effort, "revision_at_spawn": rev, "result_path": result_path,
                      "wait": f"harness wait --run {rid} --task {task['task_id']}  (run this in the background)"}, indent=2))


# ----------------------------------------------------------------------------
# results, waiting, status
# ----------------------------------------------------------------------------

def validate_result(res, schema=None):
    """Hand-rolled structural validation (no third-party deps). Returns list of problems."""
    schema = schema or load_json(SCHEMA_PATH)
    problems = []
    for key in schema["required"]:
        if key not in res:
            problems.append(f"missing required field '{key}'")
    enums = schema.get("enums", {})
    if "status" in res and res["status"] not in enums["status"]:
        problems.append(f"status must be one of {enums['status']}")
    if res.get("status") == "NOT_APPLICABLE" and not res.get("not_applicable_reason"):
        problems.append("NOT_APPLICABLE requires not_applicable_reason")
    for f in res.get("findings", []) or []:
        for k in ("id", "severity", "description", "blocking", "status"):
            if k not in f:
                problems.append(f"finding missing '{k}'")
        if f.get("severity") not in enums["severity"]:
            problems.append(f"finding {f.get('id')} severity must be one of {enums['severity']}")
        if f.get("status") not in enums["finding_status"]:
            problems.append(f"finding {f.get('id')} status must be one of {enums['finding_status']}")
    ev_ids = {e.get("id") for e in res.get("evidence", []) or []}
    for e in res.get("evidence", []) or []:
        for k in ("id", "type", "summary"):
            if k not in e:
                problems.append(f"evidence missing '{k}'")
        if e.get("type") not in enums["evidence_type"]:
            problems.append(f"evidence {e.get('id')} type must be one of {enums['evidence_type']}")
        if e.get("type") == "command" and ("command" not in e or "exit_code" not in e):
            problems.append(f"command evidence {e.get('id')} needs 'command' and 'exit_code'")
    for c in res.get("claims", []) or []:
        if not c.get("evidence_refs"):
            problems.append(f"claim '{c.get('statement','')[:40]}' has no evidence_refs")
        for ref in c.get("evidence_refs", []):
            if ref not in ev_ids:
                problems.append(f"claim references unknown evidence id '{ref}'")
    tests = res.get("tests") or {}
    if res.get("status") == "PASS" and tests.get("failed"):
        problems.append("status PASS but tests.failed is non-empty (evidence contradicts status)")
    if res.get("status") == "PASS" and any(f.get("blocking") and f.get("status") == "open" for f in res.get("findings", []) or []):
        problems.append("status PASS but an open blocking finding exists")
    if not str(res.get("revision", "")).startswith(("git:", "tree:")):
        problems.append("revision must come from `harness rev`")
    if os.environ.get("HARNESS_WRITE") == "0" and res.get("files_changed"):
        problems.append("read-only role: files_changed must be [] (you did not modify files; list what you inspected in scope_examined instead)")
    if "summary" not in res or not res.get("summary"):
        problems.append("summary (<=400 chars, for the orchestrator) is required")
    return problems


def cmd_result_validate(args):
    path = args.path or os.environ.get("HARNESS_RESULT")
    if not path:
        die("give a result path or run inside a worker (HARNESS_RESULT set)")
    try:
        res = load_json(path)
    except FileNotFoundError:
        die(f"result file not found: {path}")
    except json.JSONDecodeError as e:
        die(f"result is not valid JSON: {e}")
    problems = validate_result(res)
    root = project_root(os.path.dirname(path))
    cur = revision_id(root)
    if res.get("revision") != cur:
        problems.append(f"revision {res.get('revision')} != current working tree {cur} "
                        f"(re-run `harness rev` after your last change and update the result)")
    if problems:
        print(json.dumps({"valid": False, "problems": problems}, indent=2))
        sys.exit(1)
    print(json.dumps({"valid": True, "path": path, "status": res.get("status")}, indent=2))


def cmd_result_template(args):
    env = {k: os.environ.get(k) for k in ("HARNESS_RUN", "HARNESS_TASK", "HARNESS_AGENT", "HARNESS_ROLE", "HARNESS_PRINCIPAL", "HARNESS_RISK")}
    root = project_root()
    tpl = {
        "schema_version": "harness-result/1",
        "run_id": args.run or env["HARNESS_RUN"], "task_id": args.task or env["HARNESS_TASK"],
        "agent": env["HARNESS_AGENT"], "role": env["HARNESS_ROLE"], "principal_id": env["HARNESS_PRINCIPAL"],
        "model": config().get("worker_model", "sonnet"), "created_at": now_iso(),
        "status": "PASS | FAIL | BLOCKED | NOT_APPLICABLE | NEEDS_REVIEW",
        "risk_level": env["HARNESS_RISK"],
        "revision": revision_id(root),
        "scope_examined": [], "actions": [],
        "files_changed": changed_files(root) if os.environ.get("HARNESS_WRITE") == "1" else [],
        "evidence": [{"id": "E1", "type": "command", "command": "<exact command>", "cwd": ".", "exit_code": 0,
                      "summary": "<what it showed>", "artifact": "<path under task dir, optional>"}],
        "findings": [],
        "tests": {"executed": [], "passed": [], "failed": []},
        "claims": [{"statement": "<material claim>", "evidence_refs": ["E1"]}],
        "packs_loaded": [], "requirements_covered": [],
        "unresolved": [], "residual_risks": [],
        "handoff": {"next_agent": None, "reason": None},
        "not_applicable_reason": None,
        "summary": "<3-6 lines for the orchestrator: verdict, key findings, what was executed>",
    }
    print(json.dumps(tpl, indent=2))


def cmd_rev(args):
    print(revision_id(project_root()))


def cmd_envelope(args):
    td = os.environ.get("HARNESS_TASK_DIR")
    if not td:
        die("not inside a worker session (HARNESS_TASK_DIR unset)")
    print(open(os.path.join(td, "envelope.json"), encoding="utf-8").read())


def summarize_result(t):
    r = t.get("result")
    if not r:
        return f"{t['task_id']:<18} {t['role']:<22} PENDING"
    fnd = r.get("findings") or []
    open_by_sev = {}
    for f in fnd:
        if f.get("status") == "open":
            open_by_sev[f["severity"]] = open_by_sev.get(f["severity"], 0) + 1
    tests = r.get("tests") or {}
    return (f"{t['task_id']:<18} {t['role']:<22} {r.get('status'):<15} rev={str(r.get('revision'))[:24]} "
            f"open_findings={open_by_sev or 0} tests(p/f)={len(tests.get('passed', []))}/{len(tests.get('failed', []))} "
            f"files_changed={len(r.get('files_changed') or [])}")


def cmd_wait(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    want = args.task or [t["task_id"] for t in _tasks(rd) if t.get("spawned_at") and not t.get("result")]
    if not want:
        print("nothing to wait for")
        return
    deadline = time.time() + args.timeout
    done = {}
    while time.time() < deadline:
        for tid in want:
            if tid in done:
                continue
            rp = os.path.join(rd, "tasks", tid, "result.json")
            if os.path.exists(rp):
                try:
                    res = load_json(rp)
                except json.JSONDecodeError:
                    continue  # being written
                problems = validate_result(res)
                if problems and time.time() < deadline - args.interval:
                    continue  # worker is still being held by the Stop hook until the record validates
                done[tid] = {"status": res.get("status"), "valid": not problems, "problems": problems,
                             "summary": (res.get("summary") or "")[:400],
                             "open_findings": [f for f in res.get("findings", []) if f.get("status") == "open"],
                             "handoff": res.get("handoff"), "unresolved": res.get("unresolved"), "result_path": rp}
        if len(done) == len(want):
            break
        time.sleep(args.interval)
    pending = [t for t in want if t not in done]
    out = {"run_id": rid, "completed": done, "pending": pending}
    if pending:
        out["note"] = "timeout reached; workers still running (check their tabs)"
    print(json.dumps(out, indent=2))
    if pending:
        sys.exit(124)


def cmd_status(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    run = load_json(os.path.join(rd, "run.json"))
    print(f"run {rid}  risk={run['risk'].get('level')}  mode={run['request'].get('mode')}  workflow={run['workflow'].get('model')}  "
          f"state={run['status'].get('state')}  cycles={run.get('remediation_cycles')}")
    print(f"request: {run['request'].get('summary','')[:120]}")
    print(f"revision now: {revision_id(root)}   baseline: {run['repository'].get('baseline_revision')}")
    print("-" * 110)
    for t in _tasks(rd):
        print(summarize_result(t))
    gp = os.path.join(rd, "gate.json")
    if os.path.exists(gp):
        g = load_json(gp)
        print("-" * 110)
        print(f"last gate: {g['gate_result']} ({g.get('pass_mode')})  reasons={g.get('reason_codes')}")


# ----------------------------------------------------------------------------
# practice packs
# ----------------------------------------------------------------------------

def _front_matter(path):
    text = open(path, encoding="utf-8").read()
    if not text.startswith("---"):
        return {}, text
    end = text.find("\n---", 3)
    fm_text = text[3:end].strip()
    body = text[end + 4:]
    fm = {}
    cur_key = None
    for line in fm_text.splitlines():
        if not line.strip():
            continue
        if line.startswith("  - ") and cur_key:
            fm.setdefault(cur_key, [])
            if isinstance(fm[cur_key], list):
                fm[cur_key].append(line[4:].strip().strip('"'))
            continue
        if ":" in line and not line.startswith(" "):
            k, v = line.split(":", 1)
            cur_key = k.strip()
            v = v.strip()
            if v == "":
                fm[cur_key] = []
            elif v.startswith("[") and v.endswith("]"):
                fm[cur_key] = [x.strip().strip('"').strip("'") for x in v[1:-1].split(",") if x.strip()]
            else:
                fm[cur_key] = v.strip('"')
    return fm, body


def all_packs():
    packs = []
    for dirpath, _, files in os.walk(PACKS_DIR):
        for fn in files:
            if fn.endswith(".md") and fn != "README.md":
                p = os.path.join(dirpath, fn)
                fm, _ = _front_matter(p)
                if fm.get("id"):
                    fm["path"] = p
                    packs.append(fm)
    return sorted(packs, key=lambda x: (x.get("priority", "z"), x["id"]))


def applicable_packs(run, agent):
    ctx = set()
    cls = run.get("classification", {})
    ctx.add("always")
    for ct in [cls.get("primary_change_type")] + list(cls.get("secondary_change_types") or []):
        if ct:
            ctx.add(f"change_type:{ct}")
    for flag in ("externally_exposed", "security_boundary_affected", "privilege_boundary_affected", "persistent_data_affected",
                 "third_party_code_added", "build_or_release_path_affected", "untrusted_input_affected", "irreversible_effect_possible"):
        if cls.get(flag):
            ctx.add(f"flag:{flag}")
    if run.get("ai_scope") and run["ai_scope"] != "none":
        ctx.add("ai")
        ctx.add(f"ai_scope:{run['ai_scope']}")
    for lang in run.get("languages") or []:
        ctx.add(f"lang:{lang.lower()}")
    if run["request"].get("mode") == "VULNERABILITY_RESPONSE":
        ctx.add("mode:vulnerability_response")
    if run["request"].get("mode") == "RELEASE":
        ctx.add("mode:release")
    if run["risk"].get("level"):
        ctx.add(f"risk:{run['risk']['level']}")
        for lvl in ("R0", "R1", "R2", "R3"):
            if RISK_ORDER[lvl] <= RISK_ORDER[run["risk"]["level"]]:
                ctx.add(f"risk_at_least:{lvl}")
    out = []
    for p in all_packs():
        agents = p.get("agents") or []
        if agents and agent not in agents and "*" not in agents:
            continue
        conds = p.get("applies_when") or ["always"]
        if isinstance(conds, str):
            conds = [conds]
        if any(c in ctx for c in conds):
            out.append(p)
    # project-local pack overlay
    proj = os.path.join(run.get("project_root", "."), ".harness", "policy", "project-pack.md")
    if os.path.exists(proj):
        fm, _ = _front_matter(proj)
        fm = fm or {"id": "project.policy"}
        fm["path"] = proj
        fm["priority"] = "1-project"
        out.insert(0, fm)
    return out, sorted(ctx)


def cmd_packs(args):
    root = project_root()
    if args.list:
        for p in all_packs():
            print(f"{p['id']:<34} v{p.get('version','?'):<12} {p.get('priority','?'):<22} {p['path']}")
        return
    rid = resolve_run(root, args.run)
    run = load_json(os.path.join(run_dir(root, rid), "run.json"))
    agent = args.agent or os.environ.get("HARNESS_AGENT")
    if not agent:
        die("--agent required (or run inside a worker)")
    packs, ctx = applicable_packs(run, agent)
    print(json.dumps({"agent": agent, "context": ctx,
                      "packs": [{"id": p["id"], "version": p.get("version"), "priority": p.get("priority"), "path": p["path"]} for p in packs],
                      "instruction": "Read each pack file. Apply MUST rules; record requirement IDs you verified in result.packs_loaded / requirements_covered."}, indent=2))


# ----------------------------------------------------------------------------
# built-in deterministic scanners (machine evidence without external tools)
# ----------------------------------------------------------------------------

SECRET_PATTERNS = [
    ("aws_access_key", r"AKIA[0-9A-Z]{16}"),
    ("aws_secret_key", r"(?i)aws(.{0,20})?(secret|private)?(.{0,20})?['\"][0-9a-zA-Z/+]{40}['\"]"),
    ("private_key_block", r"-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY"),
    ("github_token", r"gh[pousr]_[A-Za-z0-9]{36,}"),
    ("slack_token", r"xox[baprs]-[0-9A-Za-z-]{10,}"),
    ("anthropic_key", r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("openai_key", r"sk-[A-Za-z0-9]{32,}"),
    ("google_api_key", r"AIza[0-9A-Za-z_-]{35}"),
    ("stripe_key", r"(sk|rk)_(live|test)_[0-9a-zA-Z]{20,}"),
    ("jwt", r"eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    ("generic_password_assignment", r"(?i)(password|passwd|pwd|secret|api[_-]?key|token)\s*[:=]\s*['\"][^'\"\s]{8,}['\"]"),
    ("connection_string_with_password", r"(?i)(postgres|mysql|mongodb|redis|amqp)://[^:\s]+:[^@\s]+@"),
]


def scan_secrets(root, paths=None):
    findings = []
    if paths is None:
        paths = changed_files(root) if is_git(root) else []
        if not paths and is_git(root):
            paths = []
    scanned = 0
    for rel in paths:
        p = os.path.join(root, rel)
        if not os.path.isfile(p) or os.path.getsize(p) > 2_000_000:
            continue
        try:
            text = open(p, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        scanned += 1
        for i, line in enumerate(text.splitlines(), 1):
            for name, rx in SECRET_PATTERNS:
                if re.search(rx, line):
                    if re.search(r"(?i)(example|placeholder|dummy|changeme|your[_-]?|<[^>]+>|xxxx|\$\{|process\.env|os\.environ|getenv)", line):
                        continue
                    findings.append({"pattern": name, "path": rel, "line": i, "redacted": re.sub(r"[A-Za-z0-9/+_-]{8,}", "****", line.strip())[:160]})
    return {"scanner": "harness.secrets", "version": "1", "files_scanned": scanned, "paths": paths, "findings": findings,
            "status": "fail" if findings else ("pass" if scanned else "inconclusive"),
            "note": "Regex heuristic scanner. A pass is evidence that no known secret pattern appears in the scanned files, not proof of absence."}


def cmd_scan(args):
    root = project_root()
    if args.kind == "secrets":
        paths = args.paths or None
        if args.all and is_git(root):
            paths = [l for l in git(root, "ls-files").stdout.splitlines() if l and not l.startswith(".harness")]
        res = scan_secrets(root, paths)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res["status"] == "pass" else 1)
    if args.kind == "deps":
        res = dependency_diff(root)
        print(json.dumps(res, indent=2))
        return
    die("unknown scan kind")


MANIFESTS = ["package.json", "requirements.txt", "requirements-dev.txt", "pyproject.toml", "Pipfile", "go.mod", "Cargo.toml",
             "Gemfile", "pom.xml", "build.gradle", "build.gradle.kts", "composer.json"]
LOCKS = ["package-lock.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock", "Pipfile.lock", "go.sum", "Cargo.lock", "Gemfile.lock", "composer.lock", "uv.lock"]


def dependency_diff(root):
    """Which manifests/locks changed vs HEAD, and a rough list of added dependency lines."""
    if not is_git(root):
        return {"is_git": False, "changed_manifests": [], "added_lines": [], "status": "inconclusive"}
    changed = changed_files(root)
    man = [c for c in changed if os.path.basename(c) in MANIFESTS]
    lock = [c for c in changed if os.path.basename(c) in LOCKS]
    added = []
    for c in man:
        diff = git(root, "diff", "HEAD", "--", c).stdout
        for line in diff.splitlines():
            if line.startswith("+") and not line.startswith("+++"):
                l = line[1:].strip()
                if re.search(r"[\"']?[A-Za-z0-9@/._-]+[\"']?\s*[:=]\s*[\"']?[\^~>=<]?\d|^[A-Za-z0-9._-]+\s*[=<>~]{1,2}\s*[\d.]+|require\s+\S+\s+v?\d|^\s*\S+\s+v\d", l):
                    added.append({"manifest": c, "line": l[:160]})
    status = "changed" if (man or lock) else "unchanged"
    return {"is_git": True, "changed_manifests": man, "changed_locks": lock, "added_lines": added, "status": status,
            "lock_without_manifest": bool(lock and not man), "manifest_without_lock": bool(man and not lock)}



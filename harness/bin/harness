def cmd_waiver(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    if not args.approved_by.startswith("human:"):
        die("waivers must be approved by a human principal, e.g. --approved-by human:<name>")
    if os.environ.get("HARNESS_ROLE"):
        die("a worker session cannot create waivers")
    wid = "W-" + uuid.uuid4().hex[:8]
    w = {"waiver_id": wid, "run_id": rid, "revision_id": revision_id(root), "finding_ids": args.finding,
         "policy_rule_ids": args.rule or [], "reason": args.reason, "compensating_controls": args.control or [],
         "approved_by": {"principal_id": args.approved_by, "role": args.role or "repository_owner"},
         "issued_at": now_iso(), "expires_at": args.expires, "status": "active"}
    save_json(os.path.join(rd, "waivers", wid + ".json"), w)
    audit(root, rid, "WAIVER_ISSUED", w, actor=args.approved_by)
    print(json.dumps(w, indent=2))


def cmd_approve(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    if not args.by.startswith("human:"):
        die("human approval must be given by a human principal, e.g. --by human:<name>")
    if os.environ.get("HARNESS_ROLE"):
        die("a worker session cannot record human approval")
    a = {"approval_id": "A-" + uuid.uuid4().hex[:8], "run_id": rid, "revision_id": revision_id(root),
         "approved_by": {"principal_id": args.by, "role": args.role or "release_authority"},
         "scope": args.scope or "release", "note": args.note or "", "issued_at": now_iso()}
    save_json(os.path.join(rd, "approvals", a["approval_id"] + ".json"), a)
    audit(root, rid, "HUMAN_APPROVAL", a, actor=args.by)
    print(json.dumps(a, indent=2))


# ----------------------------------------------------------------------------
# the policy gate
# ----------------------------------------------------------------------------

def effective_results(rd):
    """Latest valid result per task; later retries supersede the task they retry."""
    tasks = _tasks(rd)
    superseded = {t["retry_of"] for t in tasks if t.get("retry_of") and t.get("result")}
    eff = [t for t in tasks if t.get("result") and t["task_id"] not in superseded]
    return eff, tasks


def evaluate_gate(root, rid, policy=None):
    cfg = config()
    policy = policy or load_json(POLICY_PATH)
    rd = run_dir(root, rid)
    run = load_json(os.path.join(rd, "run.json"))
    cur_rev = revision_id(root)
    eff, all_tasks = effective_results(rd)
    reasons, blocking, missing, inconclusive, waived, routes, notes = [], [], [], [], [], [], []
    na = []
    schema = load_json(SCHEMA_PATH)

    risk = run["risk"].get("level")
    mode = run["request"].get("mode") or "CHANGE"
    cls = run.get("classification", {})
    ai = (run.get("ai_scope") or "none") != "none"

    if mode == "READ_ONLY":
        return {"gate_result": "NOT_APPLICABLE", "reason_codes": ["READ_ONLY_REQUEST"], "applicability": "mode == READ_ONLY"}

    if not risk:
        return _gate_result(root, rd, run, cur_rev, "FAIL", ["RISK_NOT_CLASSIFIED"], ["risk.level"], [], [], [],
                            [{"route_to": "orchestrator", "reason": "classify risk before gating"}], [], [], policy)

    # --- invalid results are treated as missing/inconclusive, never as pass
    by_role = {}
    invalid = []
    for t in eff:
        problems = validate_result(t["result"], schema)
        if problems:
            invalid.append({"task_id": t["task_id"], "problems": problems})
            continue
        by_role.setdefault(t["role"], []).append(t)
    for inv in invalid:
        inconclusive.append(f"result:{inv['task_id']}")
        reasons.append("INVALID_RESULT_RECORD")
        routes.append({"route_to": inv["task_id"], "reason": "result record failed schema validation", "problems": inv["problems"]})

    def passed(role):
        return [t for t in by_role.get(role, []) if t["result"]["status"] == "PASS"]

    def latest(role):
        ts = by_role.get(role, [])
        return sorted(ts, key=lambda t: t["result"].get("created_at", ""))[-1] if ts else None

    # --- required roles for this risk level and mode
    prof = policy["risk_profiles"][risk]
    required_roles = list(prof["required_roles"])
    conditional = prof.get("conditional_roles", {})
    triggers = {
        "third_party_code_added": bool(cls.get("third_party_code_added")),
        "persistent_data_affected": bool(cls.get("persistent_data_affected")),
        "build_or_release_path_affected": bool(cls.get("build_or_release_path_affected")),
        "ai_scope": ai,
        "externally_exposed": bool(cls.get("externally_exposed")),
        "security_boundary_affected": bool(cls.get("security_boundary_affected")),
        "privilege_boundary_affected": bool(cls.get("privilege_boundary_affected")),
    }
    for role, cond in conditional.items():
        if triggers.get(cond):
            required_roles.append(role)
    if mode == "VULNERABILITY_RESPONSE":
        required_roles += policy["vulnerability_response_roles"]
        if RISK_ORDER[risk] >= 2:
            required_roles += ["root-cause", "regression-prevention"]
        required_roles = [r for r in required_roles if r != "implementer"] if "remediation" in required_roles else required_roles
    required_roles = list(dict.fromkeys(required_roles))
    applicable_rules = [{"rule_id": f"role.{r}", "required": True} for r in required_roles]

    impl_role = "remediation" if mode == "VULNERABILITY_RESPONSE" and by_role.get("remediation") else "implementer"
    impl = latest(impl_role)
    impl_principal = impl["result"].get("principal_id") if impl else None
    if impl is None and risk == "R0" and run.get("orchestrator_implemented"):
        impl_principal = cfg.get("orchestrator_principal", "orchestrator")
        notes.append("R0: orchestrator implemented directly (permitted by policy for non-executable changes)")

    for role in required_roles:
        if role == impl_role and impl is None and impl_principal:
            continue  # R0 orchestrator implementation
        ts = by_role.get(role, [])
        if not ts:
            if role in run.get("not_applicable", {}):
                na.append({"role": role, "reason": run["not_applicable"][role]})
                if role in policy["never_not_applicable"]:
                    reasons.append("NOT_APPLICABLE_MISUSED")
                    blocking.append(f"role.{role}")
                    routes.append({"route_to": "orchestrator", "reason": f"role '{role}' cannot be marked not_applicable at {risk}"})
                continue
            missing.append(f"role.{role}")
            on_missing = policy.get("on_missing", {}).get(role, "FAIL")
            reasons.append(f"MISSING_{role.upper().replace('-', '_')}")
            routes.append({"route_to": role, "reason": f"required role '{role}' produced no result", "on_missing": on_missing})
            continue
        lt = latest(role)
        st = lt["result"]["status"]
        if st == "PASS":
            continue
        if st == "NOT_APPLICABLE":
            na.append({"role": role, "reason": lt["result"].get("not_applicable_reason"), "task": lt["task_id"]})
            if role in policy["never_not_applicable"]:
                reasons.append("NOT_APPLICABLE_MISUSED")
                blocking.append(f"role.{role}")
            continue
        if st in ("FAIL", "BLOCKED"):
            blocking.append(f"role.{role}")
            reasons.append(f"{role.upper().replace('-', '_')}_{st}")
            routes.append({"route_to": policy["remediation_routes"].get(role, "implementer"), "reason": f"{role} result is {st}",
                           "task": lt["task_id"], "findings": [f["id"] for f in lt["result"].get("findings", []) if f.get("blocking")]})
        if st == "NEEDS_REVIEW":
            inconclusive.append(f"role.{role}")
            reasons.append(f"{role.upper().replace('-', '_')}_NEEDS_REVIEW")

    # --- process-integrity invariants (non-overridable)
    # SoD applies to every independent role; revision freshness applies only to roles that evaluate the
    # final implementation. Design-time roles (architecture-review) bind to the design, dependency-review
    # binds to the manifest/lock digest (checked below), not to the final tree.
    sod_roles = [r for r in ("code-review", "security-review", "test-verification", "security-testing", "ai-adversarial-testing",
                             "architecture-review", "dependency-review", "release-integrity", "build-security", "secure-defaults") if r in required_roles]
    fresh_roles = {"code-review", "security-review", "test-verification", "security-testing", "ai-adversarial-testing",
                   "release-integrity", "build-security", "secure-defaults"}
    for role in sod_roles:
        lt = latest(role)
        if not lt:
            continue
        rp = lt["result"].get("principal_id")
        if impl_principal and rp == impl_principal:
            blocking.append(f"sod.{role}")
            reasons.append("AUTHOR_IS_REVIEWER")
            routes.append({"route_to": "orchestrator", "reason": f"{role} principal equals implementer principal {rp}"})
        if lt["result"].get("files_changed"):
            blocking.append(f"readonly.{role}")
            reasons.append("REVIEWER_MODIFIED_FILES")
            routes.append({"route_to": "orchestrator", "reason": f"{role} task {lt['task_id']} reports files_changed; reviewers must be read-only"})
        if role in fresh_roles and lt["result"].get("revision") != cur_rev:
            blocking.append(f"stale.{role}")
            reasons.append("STALE_REVIEW_EVIDENCE")
            routes.append({"route_to": role, "reason": f"{role} evidence bound to {lt['result'].get('revision')} but working tree is {cur_rev}; re-run against final revision"})
    cr, sr, stt = latest("code-review"), latest("security-review"), latest("security-testing")
    if RISK_ORDER[risk] >= 3 and cr and sr and cr["result"].get("principal_id") == sr["result"].get("principal_id"):
        blocking.append("sod.security-review-distinct")
        reasons.append("SECURITY_REVIEW_NOT_INDEPENDENT")
    if cr and stt and cr["result"].get("principal_id") == stt["result"].get("principal_id"):
        blocking.append("sod.review-vs-testing")
        reasons.append("CODE_REVIEW_AND_SECURITY_TESTING_SAME_PRINCIPAL")
    if impl and impl["result"].get("revision") != cur_rev:
        blocking.append("revision.implementer")
        reasons.append("UNEXPLAINED_CHANGES_AFTER_IMPLEMENTATION")
        routes.append({"route_to": "orchestrator", "reason": f"implementer recorded {impl['result'].get('revision')}, tree is now {cur_rev}"})
    # R3 ordering: architecture review must precede implementation
    if RISK_ORDER[risk] >= 3 and impl and latest("architecture-review"):
        ar = latest("architecture-review")
        if ar["result"].get("created_at", "") > (impl.get("spawned_at") or impl["result"].get("created_at", "")):
            blocking.append("order.architecture-before-implementation")
            reasons.append("IMPLEMENTATION_BEFORE_ARCHITECTURE_APPROVAL")

    # R0 executable-file check
    if risk == "R0":
        files = changed_files(root) if is_git(root) else (impl["result"].get("files_changed") if impl else [])
        pre = set(run["repository"].get("preexisting_changes") or [])
        bad = [f for f in files if f not in pre and not re.search(r"\.(md|mdx|rst|txt|adoc)$|(^|/)docs?/|(^|/)LICENSE|(^|/)CHANGELOG", f, re.I)]
        if bad:
            blocking.append("r0.non_doc_files_changed")
            reasons.append("R0_EXECUTABLE_FILE_CHANGED")
            routes.append({"route_to": "orchestrator", "reason": f"R0 change touched non-documentation files {bad}; reclassify at least R1"})

    # --- findings across all effective results, with waivers
    waivers = [load_json(os.path.join(rd, "waivers", w)) for w in sorted(os.listdir(os.path.join(rd, "waivers")))] if os.path.isdir(os.path.join(rd, "waivers")) else []
    valid_waivers = {}
    for w in waivers:
        ok = w.get("status") == "active" and str(w.get("approved_by", {}).get("principal_id", "")).startswith("human:")
        if w.get("expires_at") and w["expires_at"] < now_iso():
            ok = False
        if w.get("revision_id") != cur_rev:
            ok = False
        if ok:
            for fid in w.get("finding_ids", []):
                valid_waivers[fid] = w["waiver_id"]
    open_findings = []
    for t in eff:
        for f in t["result"].get("findings", []) or []:
            if f.get("status") == "open":
                ff = dict(f)
                ff["task_id"] = t["task_id"]
                open_findings.append(ff)
    thresholds = policy["finding_thresholds"][risk]
    for f in open_findings:
        sev = f["severity"]
        if sev == "critical":
            blocking.append(f"finding.{f['id']}")
            reasons.append("CRITICAL_FINDING_OPEN")
            routes.append({"route_to": policy["remediation_routes"].get("finding", "implementer"), "finding": f["id"], "task": f["task_id"], "reason": f["description"][:200]})
        elif sev in thresholds["blocking"]:
            if f["id"] in valid_waivers:
                waived.append(f["id"])
            else:
                blocking.append(f"finding.{f['id']}")
                reasons.append(f"{sev.upper()}_FINDING_OPEN")
                routes.append({"route_to": policy["remediation_routes"].get("finding", "implementer"), "finding": f["id"], "task": f["task_id"], "reason": f["description"][:200]})
        elif f.get("blocking"):
            blocking.append(f"finding.{f['id']}")
            reasons.append("BLOCKING_FINDING_OPEN")
            routes.append({"route_to": policy["remediation_routes"].get("finding", "implementer"), "finding": f["id"], "task": f["task_id"], "reason": f["description"][:200]})

    # --- test failures in any effective result
    for t in eff:
        if (t["result"].get("tests") or {}).get("failed"):
            blocking.append(f"tests.{t['task_id']}")
            reasons.append("REQUIRED_TEST_FAILED")
            routes.append({"route_to": "implementer", "task": t["task_id"], "reason": f"failed tests: {t['result']['tests']['failed'][:5]}"})

    # --- secrets scan evidence for R2+
    if RISK_ORDER[risk] >= 2:
        has_secrets_scan = any(e.get("type") == "secrets-scan" and e.get("status", "pass") == "pass"
                               for t in eff for e in t["result"].get("evidence", []) or [])
        if not has_secrets_scan:
            live = scan_secrets(root)
            if live["status"] == "fail":
                blocking.append("secrets.scan")
                reasons.append("SECRET_PATTERN_DETECTED")
                routes.append({"route_to": "implementer", "reason": "harness scan secrets found secret-like content", "findings": live["findings"]})
            elif live["status"] == "pass":
                notes.append("secrets scan executed by gate (no worker recorded one)")
            else:
                missing.append("evidence.secrets-scan")
                reasons.append("MISSING_SECRETS_SCAN")

    # --- dependency review must cover manifests if they changed
    if triggers["third_party_code_added"] or (is_git(root) and dependency_diff(root)["status"] == "changed"):
        if not passed("dependency-review") and "dependency-review" not in run.get("not_applicable", {}):
            if "role.dependency-review" not in missing and "role.dependency-review" not in blocking:
                missing.append("role.dependency-review")
                reasons.append("DEPENDENCY_MANIFEST_CHANGED_WITHOUT_REVIEW")
                routes.append({"route_to": "dependency-review", "reason": "dependency manifests/locks changed"})

    # --- human approval for R3
    if RISK_ORDER[risk] >= 3 and cfg.get("r3_requires_human_approval", True):
        apps = [load_json(os.path.join(rd, "approvals", a)) for a in sorted(os.listdir(os.path.join(rd, "approvals")))] if os.path.isdir(os.path.join(rd, "approvals")) else []
        ok = [a for a in apps if str(a.get("approved_by", {}).get("principal_id", "")).startswith("human:") and a.get("revision_id") == cur_rev]
        if not ok:
            inconclusive.append("human.release_approval")
            reasons.append("HUMAN_APPROVAL_REQUIRED")

    # --- repeated failure escalation
    if blocking and run.get("remediation_cycles", 0) >= cfg.get("max_remediation_cycles", 2):
        reasons.append("BLOCKED_REPEATED_FAILURE")
        inconclusive.append("retry.limit")

    # --- terminal decision
    reasons = list(dict.fromkeys(reasons))
    if blocking:
        result = "FAIL"
    elif any(policy.get("on_missing", {}).get(m.split(".", 1)[-1], "FAIL") == "FAIL" for m in missing):
        result = "FAIL"
    elif missing or inconclusive:
        result = "NEEDS_HUMAN"
    elif not applicable_rules:
        result = "NOT_APPLICABLE"
    else:
        result = "PASS"
        reasons.append("ALL_MANDATORY_REQUIREMENTS_SATISFIED")
        if waived:
            reasons.append("AUTHORIZED_WAIVER_APPLIED")
    return _gate_result(root, rd, run, cur_rev, result, reasons, blocking, missing, inconclusive, waived, routes, na, applicable_rules, policy,
                        extra={"required_roles": required_roles, "notes": notes, "open_findings": [{"id": f["id"], "severity": f["severity"], "task": f["task_id"]} for f in open_findings],
                               "invalid_results": invalid, "effective_tasks": [t["task_id"] for t in eff]})


def _gate_result(root, rd, run, cur_rev, result, reasons, blocking, missing, inconclusive, waived, routes, na, rules, policy, extra=None):
    g = {
        "gate_result": result,
        "pass_mode": ("WITH_WAIVERS" if waived else "CLEAN") if result == "PASS" else None,
        "run_id": run["run_id"], "risk_level": run["risk"].get("level"), "mode": run["request"].get("mode"),
        "evaluated_revision": cur_rev, "evaluated_at": now_iso(),
        "policy_id": policy.get("policy_id"), "policy_version": policy.get("version"),
        "policy_digest": sha256_text(json.dumps(policy, sort_keys=True)),
        "reason_codes": reasons, "blocking_requirements": blocking, "missing_requirements": missing,
        "inconclusive_requirements": inconclusive, "waived_findings": waived, "remediation_routes": routes,
        "not_applicable": na, "applicable_policy_rules": rules,
    }
    if extra:
        g.update(extra)
    g["evidence_bundle_digest"] = sha256_text(json.dumps({k: g[k] for k in ("effective_tasks", "evaluated_revision") if k in g}, sort_keys=True))
    save_json(os.path.join(rd, "gate.json"), g)
    hist = os.path.join(rd, "gate-history.jsonl")
    with open(hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(g) + "\n")
    audit(root, run["run_id"], "GATE_EVALUATED", {"result": result, "reasons": reasons, "revision": cur_rev}, actor="gate:harness")
    run["status"]["state"] = {"PASS": "PASS", "FAIL": "FAIL", "NEEDS_HUMAN": "NEEDS_USER_DECISION", "NOT_APPLICABLE": "COMPLETE"}[result]
    if result == "FAIL":
        run["remediation_cycles"] = run.get("remediation_cycles", 0)
    save_json(os.path.join(rd, "run.json"), run)
    return g


def cmd_gate(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    if os.environ.get("HARNESS_ROLE"):
        die("worker sessions do not evaluate the gate; the orchestrator does")
    g = evaluate_gate(root, rid)
    if args.count_cycle and g["gate_result"] == "FAIL":
        rd = run_dir(root, rid)
        run = load_json(os.path.join(rd, "run.json"))
        run["remediation_cycles"] = run.get("remediation_cycles", 0) + 1
        save_json(os.path.join(rd, "run.json"), run)
        g["remediation_cycles"] = run["remediation_cycles"]
    print(json.dumps(g, indent=2))
    sys.exit(GATE_EXIT[g["gate_result"]])


def cmd_report(args):
    root = project_root()
    rid = resolve_run(root, args.run)
    rd = run_dir(root, rid)
    run = load_json(os.path.join(rd, "run.json"))
    gp = os.path.join(rd, "gate.json")
    g = load_json(gp) if os.path.exists(gp) else {"gate_result": "NOT_EVALUATED", "reason_codes": []}
    eff, _ = effective_results(rd)
    lines = []
    status_map = {"PASS": "COMPLETE", "FAIL": "BLOCKED", "NEEDS_HUMAN": "NEEDS_USER_DECISION", "NOT_APPLICABLE": "COMPLETE", "NOT_EVALUATED": "IN_PROGRESS"}
    lines.append(f"Status: {status_map[g['gate_result']]}  (gate {g['gate_result']}{' ' + g['pass_mode'] if g.get('pass_mode') else ''})")
    lines.append(f"Risk: {run['risk'].get('level')}  triggers: {', '.join(run['risk'].get('triggers') or []) or '-'}")
    lines.append(f"Workflow: {run['workflow'].get('model') or '-'}   Revision: {g.get('evaluated_revision') or revision_id(root)}")
    lines.append("")
    lines.append(f"Summary: {run['request'].get('summary','')}")
    lines.append("")
    files = sorted({f for t in eff for f in (t["result"].get("files_changed") or [])})
    lines.append("Changed:")
    lines += [f"- {f}" for f in files] or ["- (none recorded)"]
    lines.append("")
    lines.append("Tested / Verified:")
    any_ev = False
    for t in eff:
        for e in t["result"].get("evidence", []) or []:
            if e.get("type") in ("command", "test-run", "secrets-scan", "scan", "build"):
                any_ev = True
                lines.append(f"- [{t['task_id']}] {e.get('type')}: {e.get('command', e.get('summary'))[:90]} -> exit {e.get('exit_code', '-')}: {e.get('summary','')[:100]}")
    if not any_ev:
        lines.append("- (no command evidence recorded)")
    lines.append("")
    lines.append("Independent Review:")
    for role in ("code-review", "security-review", "architecture-review", "test-verification", "security-testing", "ai-adversarial-testing", "dependency-review"):
        for t in [x for x in eff if x["role"] == role]:
            r = t["result"]
            lines.append(f"- {role} by {r.get('principal_id')} on {r.get('revision')}: {r.get('status')}; findings={len(r.get('findings') or [])}")
    lines.append("")
    lines.append("Security / Policy:")
    lines.append(f"- gate reasons: {', '.join(g.get('reason_codes') or [])}")
    for na in g.get("not_applicable", []) or []:
        lines.append(f"- not applicable: {na.get('role')} — {na.get('reason')}")
    for w in g.get("waived_findings", []) or []:
        lines.append(f"- WAIVED finding {w} (see waivers/)")
    lines.append("")
    lines.append("Evidence:")
    lines.append(f"- run dir: {rd}")
    lines.append(f"- audit trail: {os.path.join(rd, 'audit.jsonl')}")
    lines.append(f"- gate record: {gp}")
    lines.append("")
    unres = [u for t in eff for u in (t["result"].get("unresolved") or [])]
    res_risk = [u for t in eff for u in (t["result"].get("residual_risks") or [])]
    lines.append("Uncertainties / Limitations:")
    lines += [f"- {u}" for u in unres + res_risk] or ["- none recorded by workers"]
    lines.append("")
    lines.append("Follow-up Required:")
    for r in g.get("remediation_routes", []) or []:
        lines.append(f"- route to {r.get('route_to')}: {r.get('reason')}")
    if g["gate_result"] == "NEEDS_HUMAN":
        lines.append("- human decision needed; for R3 run:  harness approve --run %s --by human:<you>" % rid)
    if not g.get("remediation_routes") and g["gate_result"] == "PASS":
        lines.append("- none")
    print("\n".join(lines))


# ----------------------------------------------------------------------------
# hooks (invoked by Claude Code via settings.json)
# ----------------------------------------------------------------------------

def cmd_hook(args):
    try:
        payload = json.load(sys.stdin) if not sys.stdin.isatty() else {}
    except json.JSONDecodeError:
        payload = {}
    role = os.environ.get("HARNESS_ROLE")
    if args.event == "session-start":
        root = project_root()
        if role:
            print(f"[harness] worker session: role={role} agent={os.environ.get('HARNESS_AGENT')} task={os.environ.get('HARNESS_TASK')} "
                  f"write={'yes' if os.environ.get('HARNESS_WRITE') == '1' else 'NO (read-only)'}. Run `harness envelope` for your run envelope.")
            return
        rid = latest_run_id(root)
        if rid:
            rd = os.path.join(runs_dir(root), rid)
            run = load_json(os.path.join(rd, "run.json"), default={})
            print(f"[harness] orchestrator session. Latest run {rid}: risk={run.get('risk',{}).get('level')} state={run.get('status',{}).get('state')}. "
                  f"`harness status` for details. New work: `harness run new --request '...'`.")
        else:
            print("[harness] orchestrator session (Fable). No runs in this project yet. Change-producing requests go through `harness run new`.")
        return
    if args.event == "pre-tool-use":
        if not role:
            return
        tool = payload.get("tool_name", "")
        ti = payload.get("tool_input", {}) or {}
        write_allowed = os.environ.get("HARNESS_WRITE") == "1"
        task_dir_env = os.environ.get("HARNESS_TASK_DIR", "")
        if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
            path = ti.get("file_path") or ti.get("notebook_path") or ""
            in_task_dir = task_dir_env and os.path.abspath(path).startswith(os.path.abspath(task_dir_env))
            if not write_allowed and not in_task_dir:
                print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                  "permissionDecisionReason": f"harness: role '{role}' is read-only for product code. You may only write under your task dir {task_dir_env}. Record findings in result.json instead of fixing them."}}))
                return
            if path and os.path.abspath(path).startswith(os.path.abspath(os.path.join(project_root(), ".harness"))) and not in_task_dir:
                print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                  "permissionDecisionReason": "harness: workers may not modify other tasks' evidence, policy, waivers, or approvals."}}))
                return
        if tool == "Bash":
            cmd = ti.get("command", "")
            if re.search(r"harness\s+(gate|waiver|approve|run\s+set)\b", cmd):
                print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                  "permissionDecisionReason": "harness: workers may not evaluate the gate, issue waivers/approvals, or edit run classification."}}))
                return
            if not write_allowed and re.search(r"\bgit\s+(commit|push|checkout\s+--|reset|stash|rebase|merge|cherry-pick|clean|rm|mv|add)\b", cmd):
                print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                  "permissionDecisionReason": f"harness: role '{role}' is read-only; git state-changing commands are blocked."}}))
                return
        return
    if args.event == "stop":
        if not role:
            return
        result_path = os.environ.get("HARNESS_RESULT")
        if payload.get("stop_hook_active"):
            return  # never loop forever; the gate will treat a missing/invalid result as MISSING
        if not result_path or not os.path.exists(result_path):
            print(json.dumps({"decision": "block", "reason": f"harness: you have not written your result contract yet. "
                              f"Run `harness result template > {result_path}`, fill it with real evidence, then `harness result validate`."}))
            return
        try:
            res = load_json(result_path)
        except json.JSONDecodeError as e:
            print(json.dumps({"decision": "block", "reason": f"harness: result.json is not valid JSON ({e}). Fix it and run `harness result validate`."}))
            return
        problems = validate_result(res)
        root = project_root(os.path.dirname(result_path))
        if res.get("revision") != revision_id(root):
            problems.append("revision does not match the current working tree; run `harness rev` and update the result")
        if problems:
            print(json.dumps({"decision": "block", "reason": "harness: result contract invalid: " + "; ".join(problems[:6])}))
            return
        cmux_notify(f"harness: {os.environ.get('HARNESS_TASK')} {res.get('status')}",
                    f"{os.environ.get('HARNESS_AGENT')} finished. {str(res.get('summary') or '')[:300]}")
        try:
            cmux_run(["set-status", "harness", f"{os.environ.get('HARNESS_TASK')} {res.get('status')}",
                      "--icon", "checkmark" if res.get("status") == "PASS" else "xmark",
                      "--color", "#2e9e5b" if res.get("status") == "PASS" else "#d0453b"], timeout=5)
        except Exception:
            pass
        return
    die(f"unknown hook event {args.event}")


# ----------------------------------------------------------------------------
# doctor
# ----------------------------------------------------------------------------

def cmd_doctor(args):
    cfg = config()
    checks = []
    checks.append(("claude CLI", shutil.which("claude") or "MISSING"))
    checks.append(("python3", sys.version.split()[0]))
    checks.append(("osascript", shutil.which("osascript") or "MISSING (macOS only feature)"))
    checks.append(("cmux CLI", shutil.which("cmux") or ("app bundle only" if os.path.isdir("/Applications/cmux.app") else "not installed  (brew install --cask cmux)")))
    checks.append(("cmux socket", cmux_socket_path() or "not running (open cmux)"))
    checks.append(("inside cmux workspace", os.environ.get("CMUX_WORKSPACE_ID", "(no; start claude inside a cmux tab)")))
    checks.append(("Ghostty.app", "found" if os.path.isdir("/Applications/Ghostty.app") or os.path.isdir(os.path.expanduser("~/Applications/Ghostty.app")) else "not installed (optional fallback)"))
    checks.append(("TERM_PROGRAM", os.environ.get("TERM_PROGRAM", "(unset)")))
    checks.append(("terminal backend", detect_terminal(cfg)))
    checks.append(("worker model/effort", f"{cfg.get('worker_model')} / {cfg.get('worker_effort')}"))
    checks.append(("worker permission mode", cfg.get("worker_permission_mode")))
    checks.append(("agents dir", str(len([f for f in os.listdir(os.path.expanduser('~/.claude/agents')) if f.endswith('.md')])) + " agent definitions"))
    checks.append(("packs", str(len(all_packs())) + " practice packs"))
    checks.append(("policy", POLICY_PATH if os.path.exists(POLICY_PATH) else "MISSING"))
    settings = load_json(os.path.expanduser("~/.claude/settings.json"), default={})
    hooks = settings.get("hooks", {})
    checks.append(("hooks wired", ", ".join(k for k in ("SessionStart", "PreToolUse", "Stop") if k in hooks) or "NONE"))
    for k, v in checks:
        print(f"{k:<24} {v}")
    if args.tab_test:
        backend = detect_terminal(cfg)
        print(f"\nOpening a throwaway '{backend}' tab that prints a message and exits...")
        try:
            r = open_tab(backend, "echo 'harness tab test OK — this tab can be closed'; sleep 20", "harness tab test", cfg, cwd=os.getcwd())
            print("spawned:", r)
        except Exception as e:
            print("FAILED:", e)
            if backend == "cmux":
                print("cmux refuses connections from processes not started inside cmux. Run this from a tab inside cmux.")
        return
    if detect_terminal(cfg) == "cmux":
        print("\nWorkers will open as new cmux workspaces (vertical tabs) named '<task> <agent>' without stealing focus;\n"
              "completion shows up as a cmux notification + sidebar status pill.")
    if detect_terminal(cfg) == "ghostty":
        print("\nGhostty tabs are opened with System Events keystrokes. macOS must allow Ghostty under\n"
              "System Settings > Privacy & Security > Accessibility (add Ghostty.app). Test with: harness spawn --dry-run ...")


# ----------------------------------------------------------------------------
# argument parsing
# ----------------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(prog="harness", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)

    s = sp.add_parser("doctor", help="check installation and terminal backend"); s.add_argument("--tab-test", action="store_true", help="open a throwaway tab to prove spawning works"); s.set_defaults(fn=cmd_doctor)
    s = sp.add_parser("rev", help="print the revision id of the working tree"); s.set_defaults(fn=cmd_rev)
    s = sp.add_parser("envelope", help="(worker) print this task's run envelope"); s.set_defaults(fn=cmd_envelope)
    s = sp.add_parser("runs", help="list runs"); s.set_defaults(fn=cmd_runs)

    r = sp.add_parser("run", help="manage orchestration runs").add_subparsers(dest="sub", required=True)
    s = r.add_parser("new"); s.add_argument("--request", required=True); s.add_argument("--mode", choices=["READ_ONLY", "CHANGE", "VULNERABILITY_RESPONSE", "RELEASE"]); s.set_defaults(fn=cmd_run_new)
    s = r.add_parser("set"); s.add_argument("--run"); s.add_argument("assignments", nargs="+"); s.add_argument("--justify"); s.set_defaults(fn=cmd_run_set)
    s = r.add_parser("show"); s.add_argument("--run"); s.set_defaults(fn=cmd_run_show)

    s = sp.add_parser("classify", help="risk hints from paths"); s.add_argument("paths", nargs="*"); s.add_argument("--git", action="store_true", help="include working-tree changed files"); s.set_defaults(fn=cmd_classify)

    t = sp.add_parser("task", help="work packages").add_subparsers(dest="sub", required=True)
    s = t.add_parser("new"); s.add_argument("--run"); s.add_argument("--id", required=True); s.add_argument("--agent", required=True); s.add_argument("--role", required=True)
    s.add_argument("--write", action="store_true", default=None); s.add_argument("--depends"); s.add_argument("--retry-of"); s.add_argument("--title"); s.add_argument("--package-file"); s.add_argument("--revision"); s.set_defaults(fn=cmd_task_new)
    s = t.add_parser("list"); s.add_argument("--run"); s.set_defaults(fn=cmd_task_list)

    s = sp.add_parser("spawn", help="launch a worker session in a new terminal tab"); s.add_argument("--run"); s.add_argument("--task", required=True)
    s.add_argument("--terminal", choices=["cmux", "ghostty", "iterm", "terminal", "tmux", "bg"]); s.add_argument("--model"); s.add_argument("--effort")
    s.add_argument("--permission-mode"); s.add_argument("--dry-run", action="store_true"); s.add_argument("--force", action="store_true"); s.add_argument("--headless", action="store_true", help="run with -p in the background (no tab)")
    s.set_defaults(fn=cmd_spawn)

    s = sp.add_parser("wait", help="block until worker results exist (run in background)"); s.add_argument("--run"); s.add_argument("--task", nargs="*"); s.add_argument("--timeout", type=int, default=5400); s.add_argument("--interval", type=int, default=10); s.set_defaults(fn=cmd_wait)
    s = sp.add_parser("status", help="run overview"); s.add_argument("--run"); s.set_defaults(fn=cmd_status)

    rs = sp.add_parser("result", help="worker result contract").add_subparsers(dest="sub", required=True)
    s = rs.add_parser("template"); s.add_argument("--run"); s.add_argument("--task"); s.set_defaults(fn=cmd_result_template)
    s = rs.add_parser("validate"); s.add_argument("path", nargs="?"); s.set_defaults(fn=cmd_result_validate)

    s = sp.add_parser("packs", help="applicable practice packs"); s.add_argument("--run"); s.add_argument("--agent"); s.add_argument("--list", action="store_true"); s.set_defaults(fn=cmd_packs)
    s = sp.add_parser("scan", help="built-in deterministic scanners"); s.add_argument("kind", choices=["secrets", "deps"]); s.add_argument("paths", nargs="*"); s.add_argument("--all", action="store_true"); s.set_defaults(fn=cmd_scan)

    s = sp.add_parser("waiver", help="(human) record an authorized exception"); s.add_argument("--run"); s.add_argument("--finding", nargs="+", required=True); s.add_argument("--rule", nargs="*"); s.add_argument("--reason", required=True)
    s.add_argument("--control", nargs="*"); s.add_argument("--approved-by", required=True); s.add_argument("--role"); s.add_argument("--expires"); s.set_defaults(fn=cmd_waiver)
    s = sp.add_parser("approve", help="(human) record release/R3 approval"); s.add_argument("--run"); s.add_argument("--by", required=True); s.add_argument("--role"); s.add_argument("--scope"); s.add_argument("--note"); s.set_defaults(fn=cmd_approve)

    s = sp.add_parser("gate", help="evaluate the policy gate"); s.add_argument("--run"); s.add_argument("--count-cycle", action="store_true", help="count a FAIL as a remediation cycle"); s.set_defaults(fn=cmd_gate)
    s = sp.add_parser("report", help="final user report from gate + evidence"); s.add_argument("--run"); s.set_defaults(fn=cmd_report)
    s = sp.add_parser("hook", help="internal: Claude Code hook handler"); s.add_argument("event", choices=["session-start", "pre-tool-use", "stop"]); s.set_defaults(fn=cmd_hook)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
